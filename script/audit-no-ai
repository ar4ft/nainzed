#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
script/audit-no-ai-source
for package in zed remote_server; do
  tree=$(cargo tree --locked -p "$package" -e normal,build --prefix none "$@")
  printf '%s\n' "$tree" | python3 script/no_ai_policy.py
done
printf 'Editor and remote-helper production AI, telemetry and collaboration dependency audits passed.\n'

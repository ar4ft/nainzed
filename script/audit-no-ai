#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
tree=$(cargo tree --locked -p zed -e normal,build --prefix none "$@")
forbidden=$(printf '%s\n' "$tree" | awk '$1 ~ /^(agent|agent_ui|agent_servers|agent_client_protocol|agent_skills|copilot|copilot_ui|edit_prediction|edit_prediction_ui|language_models|anthropic|open_ai|google_ai|bedrock|ollama|codestral|open_router|deepseek|minimax|mistral|x_ai|x_ai_subscribed|zed_ai)$/ {print $1}' | sort -u)
if [[ -n "$forbidden" ]]; then
  printf 'AI implementation dependencies found:\n%s\n' "$forbidden" >&2
  exit 1
fi
printf 'Production AI dependency audit passed.\n'
